# LSPosed loads this class by name from META-INF/xposed/java_init.list, outside R8's call graph.
# Preserve its external API entry points and constructor; optimize the rest of the module normally.
-keep class com.jaco.musicenhance.hook.MusicEnhanceModule { *; }

# Framework callback interfaces are supplied by the LSPosed class loader, not bundled in the APK.
-keepattributes RuntimeVisibleAnnotations,AnnotationDefault,InnerClasses,EnclosingMethod
